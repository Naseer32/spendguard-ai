# SpendGuard agent demo. Copy to .env and fill in. NEVER commit the real .env.
# Testnet only. All values below are placeholders.

# SpendGuard backend (the dev server default is http://127.0.0.1:3000)
BACKEND_URL=http://127.0.0.1:3000

# The agent's API key (shown once when the agent was created or its key rotated)
AGENT_API_KEY=sgk_replace-me

# The backend OWNER token. The tx-report endpoint is owner-only. See README warning.
OWNER_TOKEN=replace-me

# The agent's NEAR testnet source account and its testnet secret key
SOURCE_ACCOUNT=your-agent.testnet
SOURCE_PRIVATE_KEY=ed25519:replace-me

# Optional. Defaults shown. Anything other than testnet is refused.
# NEAR_NETWORK=testnet
# NEAR_RPC_URL=https://rpc.testnet.near.org

# Optional. Change to deliberately make a NEW payment with an otherwise identical command.
# PAYMENT_SALT=

# Optional. Where the local exactly-once record lives (default: ~/.spendguard-agent-demo/state.json)
# AGENT_STATE_FILE=
