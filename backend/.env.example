# Copy this file to .env (it is git-ignored) and fill in OWNER_TOKEN.
# `npm start` loads .env automatically when it exists.

# REQUIRED. 32 to 256 printable characters, no spaces, not repetitive.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OWNER_TOKEN=

# Everything below is optional. Defaults are shown.
# DB_PATH=spendguard.sqlite
# HOST=127.0.0.1
# PORT=3000
# Exact origins, comma separated, no trailing slash. Empty means no cross-origin access.
# CORS_ORIGINS=http://localhost:5173
# APPROVAL_WINDOW_MS=86400000
# AUTHORIZATION_WINDOW_MS=3600000
# SWEEP_INTERVAL_MS=60000
# RATE_LIMIT_AUTH_FAILURES_PER_MINUTE=10
# RATE_LIMIT_EVALUATE_PER_MINUTE=60
# RATE_LIMIT_OWNER_PER_MINUTE=300
# LOG_LEVEL=info
